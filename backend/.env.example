# GrowthPilot AI Backend Environment Configuration Template
# Copy this file to .env and provide your actual credentials:
# cp .env.example .env

# Backend Server Port (defaults to 5001)
PORT=5001

# MongoDB Atlas Connection URI
# Target database: GrowthPilotAI
# Example: mongodb+srv://<username>:<password>@<cluster-host>/GrowthPilotAI?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/GrowthPilotAI?retryWrites=true&w=majority

# Sarvam AI API Subscription Key (optional - provides contextual AI analysis)
# If omitted, application runs in resilient simulated fallback mode
SARVAM_API_KEY=your_sarvam_api_key_here
