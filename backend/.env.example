# GrowthPilot AI Backend Environment Configuration Template
# Copy this file to .env and configure your local credentials:
# cp .env.example .env

# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# Allowed Frontend Origins (CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Target database: GrowthPilotAI
# Format: mongodb+srv://<username>:<password>@<cluster-host>/GrowthPilotAI?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.qd7znlr.mongodb.net/GrowthPilotAI?retryWrites=true&w=majority

# Sarvam AI API Subscription Key (optional - provides contextual AI analysis)
# If omitted or invalid, backend runs in resilient deterministic fallback mode
SARVAM_API_KEY=your_sarvam_api_key_here
