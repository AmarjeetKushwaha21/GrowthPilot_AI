# MongoDB connection URI (optional - app automatically falls back to in-memory CSV transactions if not provided)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/growthpilot_ai?retryWrites=true&w=majority

# Sarvam AI API Key (optional - app provides realistic contextual business fallbacks if not provided)
SARVAM_API_KEY=your_sarvam_api_key_here

# Backend server port (defaults to 5001)
PORT=5001
